{
	"name": "agent-space",
	"displayName": "Agent Space",
	"publisher": "ShiidoTech",
	"description": "Use different coding agents on the same feature with isolated Git worktrees and persistent sessions in VS Code",
	"version": "0.6.3",
	"agentSpaceBuild": 2,
	"icon": "media/marketplace/icon.png",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ShiidoTech/agent-space.git"
	},
	"homepage": "https://github.com/ShiidoTech/agent-space",
	"bugs": {
		"url": "https://github.com/ShiidoTech/agent-space/issues"
	},
	"categories": [
		"AI",
		"Other"
	],
	"keywords": [
		"ai",
		"agents",
		"multi-agent",
		"coding",
		"cli",
		"git",
		"worktree",
		"tmux",
		"claude",
		"codex",
		"copilot",
		"opencode"
	],
	"galleryBanner": {
		"color": "#0f172a",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "agentSpace",
					"title": "Agent Space",
					"icon": "media/icon.svg"
				}
			]
		},
		"views": {
			"agentSpace": [
				{
					"id": "agentSpace.features",
					"name": "Features",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "agentSpace.newFeature",
				"title": "New Feature",
				"category": "Agent Space",
				"icon": "$(add)"
			},
			{
				"command": "agentSpace.selectFeature",
				"title": "Select Feature",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.deleteFeature",
				"title": "Finish Feature",
				"category": "Agent Space",
				"icon": "$(trash)"
			},
			{
				"command": "agentSpace.createPR",
				"title": "Create Pull Request",
				"category": "Agent Space",
				"icon": "$(git-pull-request)"
			},
			{
				"command": "agentSpace.addAgent",
				"title": "Add Agent",
				"category": "Agent Space",
				"icon": "$(add)"
			},
			{
				"command": "agentSpace.addService",
				"title": "Add Service",
				"category": "Agent Space",
				"icon": "$(server-process)"
			},
			{
				"command": "agentSpace.openWorkspace",
				"title": "Open Workspace",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.bootstrapFeature",
				"title": "Bootstrap Feature Worktree",
				"category": "Agent Space",
				"icon": "$(sync)"
			},
			{
				"command": "agentSpace.inspectWorktrees",
				"title": "Inspect Feature Worktrees",
				"category": "Agent Space",
				"icon": "$(list-unordered)"
			},
			{
				"command": "agentSpace.inspectTmuxSessions",
				"title": "Inspect tmux Sessions",
				"category": "Agent Space",
				"icon": "$(pulse)"
			},
			{
				"command": "agentSpace.cleanUntrackedTmuxSessions",
				"title": "Clean Untracked Agent Space Sessions",
				"category": "Agent Space",
				"icon": "$(trash)"
			},
			{
				"command": "agentSpace.addProject",
				"title": "Add Project",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.editProjectBaseBranch",
				"title": "Edit Project Base Branch",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.removeProject",
				"title": "Remove Project",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.syncSessionNames",
				"title": "Sync Session Names",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.doctor",
				"title": "Doctor",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.openProjectRunbook",
				"title": "Open Project Runbook",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.reopenAgent",
				"title": "Reopen Agent",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.recoverAgentSession",
				"title": "Reconnect Existing Agent Runtime",
				"category": "Agent Space",
				"icon": "$(plug)"
			},
			{
				"command": "agentSpace.attachProviderSession",
				"title": "Attach Provider Session",
				"category": "Agent Space",
				"icon": "$(link-external)"
			},
			{
				"command": "agentSpace.openWorkspace",
				"title": "Open Feature Home",
				"category": "Agent Space",
				"icon": "$(window)"
			},
			{
				"command": "agentSpace.openHome",
				"title": "Open Home",
				"category": "Agent Space",
				"icon": "$(home)"
			},
			{
				"command": "agentSpace.openProblems",
				"title": "Open Attention Items",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.openProject",
				"title": "Open Project",
				"category": "Agent Space"
			},
			{
				"command": "agentSpace.openProjectSettings",
				"title": "Open Project Settings",
				"category": "Agent Space"
			}
		],
		"menus": {
			"view/item/context": [
				{
					"command": "agentSpace.addAgent",
					"when": "viewItem == featureActive",
					"group": "1_actions@1"
				},
				{
					"command": "agentSpace.createPR",
					"when": "viewItem == featureActive || viewItem == featureDone",
					"group": "1_actions@2"
				},
				{
					"command": "agentSpace.openFeatureGitView",
					"when": "viewItem == featureActive || viewItem == featureDone",
					"group": "1_actions@3"
				},
				{
					"command": "agentSpace.deleteFeature",
					"when": "viewItem == featureActive || viewItem == featureDone",
					"group": "2_danger@1"
				},
				{
					"command": "agentSpace.addAgent",
					"when": "viewItem == featureActive",
					"group": "inline"
				},
				{
					"command": "agentSpace.openFeatureGitView",
					"when": "viewItem == featureActive",
					"group": "inline"
				},
				{
					"command": "agentSpace.createPR",
					"when": "viewItem == featureActive",
					"group": "inline"
				}
			]
		},
		"configuration": {
			"title": "Agent Space",
			"properties": {
				"agentSpace.notifyWhenAgentsNeedYou": {
					"type": "boolean",
					"default": true,
					"description": "Show a notification when a coding agent starts waiting for your input."
				},
				"agentSpace.enablePerAgentIsolation": {
					"type": "boolean",
					"default": false,
					"description": "Enable per-agent worktree isolation. When disabled, every feature uses a single shared worktree."
				},
				"agentSpace.syncSessionNames": {
					"type": "boolean",
					"default": true,
					"description": "Sync agent names from supported CLI rename metadata"
				},
				"agentSpace.autoNameAgents": {
					"type": "boolean",
					"default": true,
					"description": "Deprecated: use agentSpace.syncSessionNames instead. Falls back to this if syncSessionNames is not set."
				},
				"agentSpace.codingTools": {
					"type": "array",
					"default": [],
					"items": {
						"type": "object",
						"if": {
							"properties": {
								"enabled": {
									"const": false
								}
							}
						},
						"then": {
							"required": [
								"id"
							]
						},
						"else": {
							"required": [
								"id",
								"name",
								"command"
							]
						},
						"properties": {
							"id": {
								"type": "string",
								"description": "Unique identifier"
							},
							"enabled": {
								"type": "boolean",
								"description": "When false, removes the matching built-in tool"
							},
							"name": {
								"type": "string",
								"description": "Display name"
							},
							"command": {
								"type": "string",
								"description": "CLI command to execute"
							},
							"args": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "CLI arguments"
							},
							"env": {
								"type": "object",
								"description": "Environment variables merged into the launched CLI process (e.g. a personal profile config dir)"
							},
							"family": {
								"type": "string",
								"enum": [
									"claude",
									"codex",
									"opencode",
									"generic"
								],
								"description": "Session-handling family. claude-family CLIs are launched with --session-id and resumed with --resume <sessionId>."
							},
							"sessionsDir": {
								"type": "string",
								"description": "Directory where the CLI stores its session index (used for name/rename discovery)"
							},
							"resumeCommand": {
								"type": "string",
								"description": "Explicit resume template using {command} and {sessionId} placeholders"
							}
						}
					},
					"description": "Custom coding CLI tools. Built-in tools (claude, codex, copilot, opencode, hermes) are available by default; add an entry with \"enabled\": false to hide one."
				},
				"agentSpace.defaultTool": {
					"type": "string",
					"markdownDescription": "Default coding tool ID for new agents. On first start, Agent Space prompts you to choose from the coding CLIs available on PATH. Built-in IDs include `claude`, `codex`, `copilot`, `opencode`, and `hermes`; custom tools can be declared in `agentSpace.codingTools`.",
					"examples": [
						"codex",
						"claude",
						"copilot",
						"opencode"
					]
				},
				"agentSpace.worktreeBasePath": {
					"type": "string",
					"default": ".worktrees",
					"description": "Base directory for git worktrees, relative to the project root."
				}
			}
		}
	},
	"scripts": {
		"esbuild": "node esbuild.js",
		"esbuild:watch": "node esbuild.js --watch",
		"compile": "tsc -noEmit && node esbuild.js",
		"watch": "node esbuild.js --watch",
		"check:fix": "biome check --error-on-warnings --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"package": "npm run compile && vsce package --no-dependencies && npm run package:verify",
		"package:verify": "node scripts/verify-package.mjs",
		"deploy": "bash scripts/deploy.sh",
		"release:patch": "bash scripts/release.sh patch",
		"release:minor": "bash scripts/release.sh minor",
		"release:major": "bash scripts/release.sh major"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.90.0",
		"@vscode/vsce": "3.9.2",
		"esbuild": "^0.20.0",
		"typescript": "^5.3.0",
		"vitest": "^4.0.18"
	}
}
